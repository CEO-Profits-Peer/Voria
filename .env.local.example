# ============================================================
# Voria — Vorlage für Zugangsdaten
#
# ACHTUNG: Diese Datei wird ins Repo hochgeladen.
# Hier stehen NUR Platzhalter, niemals echte Werte.
#
# Echte Werte gehören in `.env.local` — die steht in .gitignore
# und bleibt auf deinem Rechner.
#
# Passwörter gehören in KEINE der beiden Dateien.
# GitHub-Zugang läuft über SSH-Schlüssel oder die GitHub CLI.
# ============================================================

# ---------- Supabase ----------------------------------------
# Dashboard → Project Settings → Data API

# Eine Adresse, kein Schlüssel:
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co

# Öffentlicher Schlüssel, darf im Browser landen.
# Zugriff wird über Row Level Security geregelt.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GEHEIM. Umgeht alle Zugriffsregeln. Nur serverseitig.
SUPABASE_SERVICE_ROLE_KEY=


# ---------- Fotospeicher ------------------------------------
# "supabase" = 1 GB frei, kein Zahlungsmittel nötig   ← Standard
# "r2"       = günstiger bei Masse, verlangt aber eine Karte
#
# Umstellen genügt. Der Code liegt in src/lib/storage.ts.

STORAGE_DRIVER=supabase


# ---------- Cloudflare R2 (erst später nötig) ---------------
# Leer lassen, solange STORAGE_DRIVER=supabase

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=voria-photos
NEXT_PUBLIC_R2_PUBLIC_URL=


# ---------- Gemini (ab Phase 1) -----------------------------

GEMINI_API_KEY=


# ---------- Paddle (Abonnements) ----------------------------
#
# PADDLE_WEBHOOK_SECRET ist das Geheimnis der Benachrichtigung,
# NICHT der API-Schlüssel. Zu finden im Paddle-Dashboard unter
# Notifications, je Ziel ein eigenes.
#
# Ohne diesen Wert lehnt /api/paddle jede Meldung ab. Das ist
# Absicht: Die Route ist die einzige Stelle, die ein Abo anlegen
# darf — ohne Signaturpruefung waere sie ein offenes Formular, in
# das jeder "ich habe bezahlt" schreiben kann.

PADDLE_WEBHOOK_SECRET=

# Beim Kauf MUSS custom_data.user_id mit der Voria-Nutzerkennung
# belegt werden. Das ist die einzige Bruecke zwischen einem
# Paddle-Kunden und einem Konto hier.


# ---------- Werbenetz (optional) ----------------------------
#
# Adresse des Anzeigen-Skripts. Leer = kein Netz, der Feed zeigt
# nur die eigenen Anzeigen aus src/features/social/werbung.ts.
#
# ACHTUNG, LIES DEN KOPF VON src/features/social/ExterneAnzeige.tsx:
# In /datenschutz steht, dass Anzeigen OHNE Nutzerdaten ausgespielt
# werden und es kein Tracking gibt. Die grossen Netze (AdSense,
# Media.net) tun das Gegenteil. Wer eines davon eintraegt, MUSS
# zuerst die Datenschutzerklaerung umschreiben und eine Einwilligung
# einholen — sonst ist sie schlicht falsch.

NEXT_PUBLIC_WERBENETZ=
